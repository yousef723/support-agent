OPENAI_API_KEY=paste-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Used by docker compose: the key a demo business gets on first start
DEMO_API_KEY=pick-a-long-random-secret

# Local run without Docker uses a SQLite file:
DB_PATH=support.db
# To use PostgreSQL locally instead, uncomment (docker compose sets this for you):
# DATABASE_URL=postgresql://support:support@localhost:5432/support
